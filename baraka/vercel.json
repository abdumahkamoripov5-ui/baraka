{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run check",
  "outputDirectory": "vercel-public",
  "functions": {
    "api/entry.js": {
      "includeFiles": "dist/**",
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/welcome.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api/entry"
    }
  ]
}
