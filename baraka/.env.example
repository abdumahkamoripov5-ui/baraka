# Docker Compose deployment only. Do not use example values in production.
BARAKA_DOMAIN=baraka.your-domain.uz
PUSH_CONTACT=mailto:owner@your-domain.uz
# Node runtime variables (set via PowerShell / service manager for local npm start):
# APP_ORIGIN=https://baraka.your-domain.uz
# HOST=0.0.0.0
# BARAKA_DATA_DIR=/persistent/baraka
# BARAKA_UTILITY_ADAPTER=/absolute/path/operator-adapter.cjs
# BARAKA_PAYMENT_ALLOWED_HOSTS=official-checkout-host-from-your-provider
# Optional: live bus operator adapter (not supplied until an operator is selected).
# BARAKA_TRANSIT_ADAPTER=/absolute/path/authorized-transit-adapter.cjs
# Optional: paid telephone reminders. Set only after verifying recipients and consent.
# VOICE_TWILIO_ACCOUNT_SID=
# VOICE_TWILIO_AUTH_TOKEN=
# VOICE_FROM_NUMBER=
# VOICE_RECIPIENTS_JSON={"verified-login@example.com":"ADMIN_VERIFIED_E164_NUMBER"}

# Telefon OTP va email parol tiklash: administrator boshqaradigan CommonJS modul
BARAKA_ACCESS_ADAPTER=
# Faqat foydalanuvchi botda Start bosib tasdiqlagandan keyin eslatma yuboriladi
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

# Vercel + Neon: only in Vercel Environment Variables, never commit real values.
# APP_ORIGIN=https://YOUR-PROJECT.vercel.app
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
# No BARAKA_DATA_DIR, push keys or scheduler required for the Vercel variant.
